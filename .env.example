# Supabase
# Found in: Supabase dashboard → Project Settings → API
#
# NOTE: This is a static site. These values live in assets/js/supabase.js, not in
# a .env file. This file is a reference so you know where to look when
# setting up a new project or handing off to a developer.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# The ANON key is safe to expose in front-end code — it is intentionally
# public and protected by Row Level Security policies in Supabase.
# NEVER use the service_role key in any front-end file.

# Calendly
# The Calendly booking URL embedded on the contact/home page.
# Found in: Calendly → Event Types → copy the event link

CALENDLY_URL=https://calendly.com/YOUR_USERNAME/YOUR_EVENT

# Vercel
# Set automatically by the Vercel CLI / CI — do not set manually.
# VERCEL_OIDC_TOKEN is generated per-deployment and must never be committed.
